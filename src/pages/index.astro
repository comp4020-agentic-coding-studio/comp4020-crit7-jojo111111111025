---
import { listCourses } from "../lib/db";
import { PLANNING_LOAD_REFERENCE_UNITS, summarizePlan } from "../lib/plan-summary";
import "../styles.css";

const courses = listCourses();
const plan = summarizePlan(courses);
const loadPercent = Math.min(100, Math.round((plan.totalUnits / PLANNING_LOAD_REFERENCE_UNITS) * 100));
const loadBadgeClass = {
  "Light load": "light",
  "Standard load": "standard",
  "Full load": "full",
  "Above 24 units": "over",
}[plan.loadLabel];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Semester Planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <div class="planner-header">
        <p class="semester-badge">Semester 2, 2026</p>
        <h1>ANU Semester Planner</h1>
        <p class="tagline">Plan your semester before you enrol.</p>
        <p class="lede">
          Keep track of the courses you're considering for this semester and
          see your study load at a glance. The plan lives in SQLite, so it's
          still here after a reload — this is a planning tool, not ANU's real
          enrolment system.
        </p>
      </div>

      <section aria-labelledby="plan-heading">
        <div
          class="plan-summary"
          data-course-count={plan.count}
          data-total-units={plan.totalUnits}
          data-load-label={plan.loadLabel}
          data-core-count={plan.coreCount}
          data-elective-count={plan.electiveCount}
        >
          <h2 id="plan-heading">Your plan</h2>
          <p class="plan-counts">
            {`${plan.count} ${plan.count === 1 ? "course" : "courses"} · ${plan.totalUnits} ${plan.totalUnits === 1 ? "unit" : "units"}`}
          </p>
          {
            plan.count > 0 && (
              <p class="plan-breakdown">
                {`${plan.coreCount} Core · ${plan.electiveCount} Elective`}
              </p>
            )
          }
          <p class="plan-load">
            {`Study load: ${plan.totalUnits} / ${PLANNING_LOAD_REFERENCE_UNITS} units`}
            <span class={`load-badge load-badge--${loadBadgeClass}`}>{plan.loadLabel}</span>
          </p>
          <div class="load-bar" aria-hidden="true">
            <div class="load-bar-fill" style={`width: ${loadPercent}%`} />
          </div>
          <p class="load-disclaimer">
            A planning reference, not an official ANU enrolment assessment.
          </p>
        </div>

        {
          courses.length === 0 ? (
            <div class="empty-state">
              <p>No courses planned yet.</p>
              <p>Add the courses you're considering for this semester to build your plan.</p>
            </div>
          ) : (
            <ul id="courses">
              {courses.map((course) => (
                <li class="course-card">
                  <div class="course-info">
                    <div class="course-heading">
                      <span class="course-code">{course.code}</span>
                      <span class="course-title">{course.title}</span>
                    </div>
                    <div class="course-meta">
                      <span class={`type-badge type-badge--${course.type}`}>
                        {course.type === "elective" ? "Elective" : "Core"}
                      </span>
                      <span class="course-units">{`${course.units} units`}</span>
                    </div>
                  </div>
                  <form method="post" action={`/api/courses/${course.id}/delete`}>
                    <button class="remove-button" aria-label={`Remove ${course.code} from your plan`}>
                      Remove
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section aria-labelledby="add-heading">
        <h2 id="add-heading">Add a course</h2>
        <form method="post" action="/api/courses" class="add-course-form">
          <div class="field">
            <label for="code">Course code</label>
            <input
              id="code"
              name="code"
              required
              maxlength="20"
              placeholder="e.g. COMP4020"
              aria-describedby="code-hint"
            />
            <small id="code-hint">The code as it appears in the ANU handbook</small>
          </div>
          <div class="field">
            <label for="title">Title</label>
            <input id="title" name="title" required maxlength="200" placeholder="e.g. Agentic Coding Studio" />
          </div>
          <div class="field">
            <label for="type">Course type</label>
            <select id="type" name="type" required>
              <option value="core">Core</option>
              <option value="elective">Elective</option>
            </select>
          </div>
          <div class="field">
            <label for="units">Units</label>
            <input id="units" name="units" type="number" min="1" value="6" aria-describedby="units-hint" />
            <small id="units-hint">Most ANU courses are 6 units</small>
          </div>
          <div class="field submit-field">
            <button class="primary-button">Add course</button>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
