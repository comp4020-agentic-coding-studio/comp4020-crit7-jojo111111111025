---
import { listCourses } from "../lib/db";
import "../styles.css";

const courses = listCourses();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU course planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Semester course plan</h1>
      <p>
        A lightweight place to plan a semester before enrolling: add the
        courses you're considering, see them listed with their unit value,
        and drop any you change your mind about. The plan lives in SQLite, so
        it's still here after a reload.
      </p>
      <form method="post" action="/api/courses">
        <label for="code">Course code</label>
        <input id="code" name="code" required maxlength="20" placeholder="COMP4020" />
        <label for="title">Title</label>
        <input id="title" name="title" required maxlength="200" placeholder="Agentic Coding Studio" />
        <label for="units">Units</label>
        <input id="units" name="units" type="number" min="1" value="6" />
        <button>Add course</button>
      </form>
      <ul id="courses">
        {
          courses.map((course) => (
            <li>
              <span>
                <strong>{course.code}</strong> — {course.title} ({course.units} units)
              </span>
              <form method="post" action={`/api/courses/${course.id}/delete`}>
                <button aria-label={`Remove ${course.code}`}>Remove</button>
              </form>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
